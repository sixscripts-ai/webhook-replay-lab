// Webhook Replay Lab — Prisma schema
// Postgres is the target database. Tables are designed to be append-friendly:
// every webhook is stored even if its shape is unknown.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  received
  delivered
  failed
  replayed
  dead_letter
}

enum ReplayStatus {
  success
  failed
}

enum EvalRunStatus {
  pass
  fail
}

enum BackoffStrategy {
  none
  fixed
  exponential
}

enum SignatureStatus {
  not_configured
  verified
  failed
}

model WebhookEvent {
  id                       String          @id @default(cuid())
  provider                 String
  eventType                String
  status                   EventStatus     @default(received)
  headers                  Json
  payload                  Json
  receivedAt               DateTime        @default(now())
  lastReplayAt             DateTime?
  targetId                 String?
  errorMessage             String?
  // Dedupe
  externalEventId          String?
  dedupeKey                String?         @unique
  duplicateCount           Int             @default(0)
  firstSeenAt              DateTime        @default(now())
  lastSeenAt               DateTime        @default(now())
  // Signature verification
  signatureStatus          SignatureStatus @default(not_configured)
  signatureHeaderName      String?
  signatureVerifiedAt      DateTime?
  signatureFailureReason   String?
  // Dead-letter tracking
  deadLetterReason         String?
  deadLetteredAt           DateTime?
  deadLetterReviewedAt     DateTime?
  deadLetterReviewedBy     String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  target        ReplayTarget?   @relation(fields: [targetId], references: [id], onDelete: SetNull)
  replayAttempts ReplayAttempt[]
  evalTestCases  EvalTestCase[]

  @@index([provider])
  @@index([status])
  @@index([receivedAt])
  @@index([eventType])
  @@index([signatureStatus])
  @@index([deadLetteredAt])
}

model ReplayTarget {
  id                              String          @id @default(cuid())
  name                            String
  provider                        String
  url                             String
  isActive                        Boolean         @default(true)
  // Retry policy
  isRetryEnabled                  Boolean         @default(false)
  maxAttempts                     Int             @default(1)
  backoffStrategy                 BackoffStrategy @default(none)
  backoffBaseMs                   Int             @default(500)
  timeoutMs                       Int             @default(15000)
  retryOnStatuses                 Json            @default("[500,502,503,504]")
  // Signature verification config
  isSignatureVerificationEnabled  Boolean         @default(false)
  signatureHeaderName             String?
  signatureAlgorithm              String?         // currently only hmac-sha256
  signingSecretEnvVar             String?         // name of env var holding secret
  createdAt                       DateTime        @default(now())
  updatedAt                       DateTime        @updatedAt

  events         WebhookEvent[]
  replayAttempts ReplayAttempt[]
  evalTestCases  EvalTestCase[]

  @@index([provider])
  @@index([isActive])
}

model ReplayAttempt {
  id              String       @id @default(cuid())
  eventId         String
  targetId        String
  status          ReplayStatus
  requestPayload  Json
  responseStatus  Int?
  responseBody    String?
  durationMs      Int?
  errorMessage    String?
  attemptedAt     DateTime     @default(now())
  // Run grouping + retry semantics
  runId           String?
  attemptNumber   Int          @default(1)
  isAutomatic     Boolean      @default(false)
  backoffDelayMs  Int?

  event   WebhookEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  target  ReplayTarget  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  evalRuns EvalRun[]

  @@index([eventId])
  @@index([targetId])
  @@index([status])
  @@index([attemptedAt])
  @@index([runId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model EvalTestCase {
  id                     String   @id @default(cuid())
  name                   String
  description            String?
  eventId                String?
  targetId               String?
  expectedStatus         Int
  expectedBodyIncludes   String?
  expectedMaxDurationMs  Int?
  assertions             Json?    // optional rich assertion array
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  event   WebhookEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  target  ReplayTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  runs    EvalRun[]

  @@index([isActive])
}

model EvalRun {
  id              String         @id @default(cuid())
  testCaseId      String
  replayAttemptId String?
  status          EvalRunStatus
  expectedStatus  Int
  actualStatus    Int?
  evidence        Json
  notes           String?
  createdAt       DateTime       @default(now())

  testCase      EvalTestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  replayAttempt ReplayAttempt? @relation(fields: [replayAttemptId], references: [id], onDelete: SetNull)

  @@index([testCaseId])
  @@index([status])
  @@index([createdAt])
}
